#ifndef RUSTPAINT_VERSION_H_
#define RUSTPAINT_VERSION_H_

/*
  Generated by tools/New-BuildVersion.ps1 from the project-root VERSION.txt.
  Do not edit by hand and do not commit a hand-tuned copy: the serial
  assertion channel (APP_VERSION=), expected_version.txt and the version
  string drawn in the status bar must all come from these macros, or the
  version check will (correctly) fail.
*/

#define RUSTPAINT_VERSION_MAJOR @VER_MAJOR@
#define RUSTPAINT_VERSION_MINOR @VER_MINOR@
#define RUSTPAINT_VERSION_PATCH @VER_PATCH@
#define RUSTPAINT_BUILD         @BUILD_NUMBER@

/* ASCII strings. RUSTPAINT_VERSION_STR is the exact byte string that
   expected_version.txt holds and that tools/Test-AppVersion.ps1 compares
   against the APP_VERSION= line on the serial channel. */
#define RUSTPAINT_VERSION_STR   "@VERSION_STRING@"
#define RUSTPAINT_BUILD_STR     "@BUILD_TIMESTAMP@"

#endif /* RUSTPAINT_VERSION_H_ */
